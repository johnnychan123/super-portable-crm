{
  "name": "super-portable-crm",
  "productName": "Super Portable CRM",
  "version": "0.3.0",
  "description": "Cross-platform portable CRM desktop application for Excel data processing and analysis",
  "main": "dist-electron/main.cjs",
  "author": "johnnychan123",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "bun run build && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:renderer": "vite build",
    "build:electron": "bun build ./electron/main.ts --outfile ./dist-electron/main.cjs --target=node --format=cjs --external=electron && bun build ./electron/preload.ts --outfile ./dist-electron/preload.cjs --target=node --format=cjs --external=electron",
    "build": "bun run build:renderer && bun run build:electron",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dist": "bun run build && electron-builder --publish never",
    "dist:win": "bun run build && electron-builder --win --publish never",
    "dist:mac": "bun run build && electron-builder --mac --publish never",
    "dist:linux": "bun run build && electron-builder --linux --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "lucide-react": "^1.64.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "xlsx": "^0.18.5"
  }
}
